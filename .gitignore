# OS and editors
.DS_Store
.idea/
.vscode/
*.iml
*.swp

# Dependencies and build output
node_modules/
dist/
.next/
.turbo
*.tsbuildinfo

# Env files and secrets (never commit)
.env*
!.env.example
*.pem
*.p12
*.mobileprovision
**/GoogleService-Info.plist
**/google-services.json
apps/mobile/ios/Flutter/Local.xcconfig

# Local data
backend/api/data/
*.sqlite
*.sqlite-journal

# Vercel
.vercel

# Flutter / Dart (apps/mobile/.gitignore has more)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
build/
**/DerivedData/
xcuserdata/

# Logs
*.log

# Eval reports (written by backend/convex/evals; keep the folder)
backend/convex/evals/reports/*
!backend/convex/evals/reports/.gitkeep
