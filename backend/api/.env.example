# Copy to .env and fill in. Never commit .env.

# Shared secret the app sends as "Authorization: Bearer <token>". If empty, a random one is generated and printed at each start.
APP_TOKEN=

# Server (defaults: HOST=0.0.0.0, PORT=8787, DB_PATH=./data/opengym.db; uploads go to a "files" dir next to the DB file)
HOST=
PORT=
DB_PATH=
# SQLite journal mode: WAL (default) | DELETE | TRUNCATE | PERSIST | MEMORY | OFF. Use DELETE on Cloud Storage (gcsfuse) mounts.
SQLITE_JOURNAL_MODE=

# AI provider: anthropic | openai | deepseek | mock | none (default none)
AI_PROVIDER=mock

# Anthropic (needed when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# OpenAI (needed when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek (needed when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
